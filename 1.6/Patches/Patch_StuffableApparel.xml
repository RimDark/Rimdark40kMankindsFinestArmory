<?xml version="1.0" encoding="utf-8"?>
<!-- Makes the Mankind's Finest Armory apparel stuffable. Each piece keeps its old stats when made from its
     default material (its old main ingredient); other materials raise or lower armor or melee damage,
     hit points, work and flammability the vanilla way. The framework's DefModExtension_IgnoreStuffColor keeps
     the textures untinted with every material, and DefModExtension_FixedGenerationStuff makes
     generated pawns always get the default material. It can be switched off in VEF's mod settings
     (toggleable patches; needs a restart). Generated by notes/CodexRimperialisGrimWorld/gen_stuffable.py. -->
<Patch>

    <Operation Class="VEF.PatchOperationToggableSequence">
        <enabled>True</enabled>
        <label>Make the undersuit stuffable:</label>
        <operations>

            <!-- BEWH_Undersuit: Steel x50 (Metallic) -->
            <li Class="PatchOperationReplace">
                <xpath>Defs/ThingDef[defName="BEWH_Undersuit"]/costList</xpath>
                <value>
                    <costList Inherit="False">
                        <Plasteel>15</Plasteel>
                        <Chemfuel>35</Chemfuel>
                        <ComponentIndustrial>3</ComponentIndustrial>
                    </costList>
                </value>
            </li>
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="BEWH_Undersuit"]</xpath>
                <value>
                    <stuffCategories>
                        <li>Metallic</li>
                    </stuffCategories>
                    <costStuffCount>50</costStuffCount>
                    <defaultStuff>Steel</defaultStuff>
                </value>
            </li>
            <li Class="PatchOperationReplace">
                <xpath>Defs/ThingDef[defName="BEWH_Undersuit"]/statBases/Flammability</xpath>
                <value>
                    <Flammability>1</Flammability>
                </value>
            </li>
            <li Class="PatchOperationReplace">
                <xpath>Defs/ThingDef[defName="BEWH_Undersuit"]/statBases/ArmorRating_Sharp</xpath>
                <value>
                    <ArmorRating_Sharp>0.001</ArmorRating_Sharp>
                </value>
            </li>
            <li Class="PatchOperationReplace">
                <xpath>Defs/ThingDef[defName="BEWH_Undersuit"]/statBases/ArmorRating_Blunt</xpath>
                <value>
                    <ArmorRating_Blunt>0.09</ArmorRating_Blunt>
                </value>
            </li>
            <li Class="PatchOperationReplace">
                <xpath>Defs/ThingDef[defName="BEWH_Undersuit"]/statBases/ArmorRating_Heat</xpath>
                <value>
                    <ArmorRating_Heat>0.044</ArmorRating_Heat>
                </value>
            </li>
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="BEWH_Undersuit"]/statBases</xpath>
                <value>
                    <StuffEffectMultiplierArmor>0.51</StuffEffectMultiplierArmor>
                </value>
            </li>

            <!-- Keep the original texture colours; generated pawns get the default material -->
            <li Class="PatchOperationAdd">
                <success>Always</success>
                <xpath>Defs/ThingDef[(defName="BEWH_Undersuit") and not(modExtensions)]</xpath>
                <value>
                    <modExtensions />
                </value>
            </li>
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="BEWH_Undersuit"]/modExtensions</xpath>
                <value>
                    <li Class="Core40k.DefModExtension_IgnoreStuffColor" />
                    <li Class="Core40k.DefModExtension_FixedGenerationStuff" />
                </value>
            </li>

        </operations>
    </Operation>

</Patch>
